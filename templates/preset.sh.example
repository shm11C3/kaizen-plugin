# Preset for a new contest. Fill every value from the day's manual and the
# servers themselves, save as presets/<contest>.sh (or straight into
# .kaizen/config.sh), and keep the manual's URL in a comment next to each
# value you took from it.

# Name of the contest/problem; knowledge records are filed under it.
PROBLEM=<contest>

# Where the application lives on each server and what to push there.
REMOTE_APP_DIR=/home/isucon/webapp
LOCAL_SYNC_PATHS="go sql"            # choose actual Go or Rust source directories
SYNC_EXCLUDES="--exclude <binary>"   # build outputs that live next to sources
RSYNC_PATH="sudo -u isucon rsync"

# Build, restart, health. Run over SSH on every host in APP_HOSTS.
BUILD_CMD='sudo -i -u isucon bash -c "cd ~/webapp/go && go build -o <binary> ."'
# Rust example: set its real crate/binary/service paths; preserve remote caches
# across rsync --delete. See team/docs/RUST_BUILD.md for build/recovery time budgets.
# LOCAL_SYNC_PATHS="rust sql"
# SYNC_EXCLUDES="--exclude target/"
# BUILD_CMD='sudo -i -u isucon bash -c "cd ~/webapp/rust && cargo build --release --locked"'
RESTART_CMD='sudo systemctl daemon-reload && sudo systemctl restart <service>'
SERVICE_NAME=<service>
HEALTH_CMD='curl -s -o /dev/null -m 3 http://127.0.0.1:8080/'
HEALTH_RETRIES=20

# Configuration overlay: <repo>/etc/... -> /etc/... on every host,
# <repo>/etc-<host>/... -> /etc/... on that host. Map top-level directories
# to the service that must restart when files under them change.
OVERLAY_DIR=etc
OVERLAY_SERVICES="mysql:mysql.service nginx:nginx.service systemd:daemon-reload"
VERIFY_EXCLUDE_REGEX='\.gz$'

# Observation sources.
ACCESS_LOG=/var/log/nginx/access.log
MYSQL_CMD="sudo mysql"
DB_NAME=<database>
PATH_ID_REGEX='/[0-9A-Za-z]{20,}'    # how ids look in URLs, for grouping
# OBSERVE_EXTRA_CMD='sudo alp ltsv --file /var/log/nginx/access.log --sort sum -r --limit 30'

# Cumulative request counter: one nonnegative integer. SSH: before/after the
# run; manual: reserve/result. Set NGINX_HOST to its actual host. Changes to
# this command, host or parse_bench_requests require fresh capture/baselines.
REQUEST_COUNT_CMD='sudo wc -l < /var/log/nginx/access.log'
# EVALUATION_RULE=v3  # sequential rule; opt in only after the comparison in DESIGN_REVIEW.md

# Benchmark. On contest day the portal runs it: BENCH_MODE=manual and
# bench.sh <label> --reserve before the portal, --result 'pass=true score=1234 errors=...' after it ended.
# In practice with a reachable benchmarker: BENCH_MODE=ssh plus the two
# functions below.
BENCH_MODE=manual
# BENCH_HOST=bench
# bench_command() { echo "<command that runs one benchmark and prints its result>"; }
# parse_bench() { # <log> -> "pass score errors"
#   local line; line=$(grep -o 'pass=[a-z]* score=[0-9]*' "$1" | tail -1) || return 1
#   echo "$(sed -n 's/.*pass=\([a-z]*\).*/\1/p' <<<"$line") $(sed -n 's/.*score=\([0-9]*\).*/\1/p' <<<"$line") none"
# }

# Quality denominators when the benchmark supplies a comparable request count:
# parse_bench_requests() { # <log> -> nonnegative integer; never estimate from score
#   ...
# }
# RESOURCE_FINGERPRINT_CMD and RECOVERY_CMD: see team/docs/RECOVERY.md.

# Costly collectors use observe start NAME / stop; verify actual tool state.
# OBSERVE_TOOLS=otel,pprof
# OBSERVE_START_CMD='... enable private collector and restart observation build ...'
# OBSERVE_STOP_CMD='... disable collector and restart normal build ...'
