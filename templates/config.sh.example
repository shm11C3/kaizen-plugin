# Copy to <project>/.kaizen/config.sh and fill in the hosts.
# Sourced by every kaizen script; keep it shell, keep secrets out of it.

# Practice: the ISUCON14 preset. Contest day: a preset you filled from the
# manual (templates/preset.sh.example) or the values inline below.
. "$KAIZEN_PLUGIN_ROOT/presets/isucon14.sh"

# SSH aliases (from SSH_CONFIG or ~/.ssh/config). APP_HOSTS all receive the
# deploy; APP_HOST is the first of them unless the roles differ.
APP_HOST=isu1
APP_HOSTS="isu1"                 # contest: "isu1 isu2 isu3"
DB_HOST=isu1                     # where observe.sh reads performance_schema
SSH_CONFIG=/Users/you/Develop/ISUCON/ssh_config

# Practice only (BENCH_MODE=ssh): the benchmarker host and the addresses the
# hosts use to reach each other. Contest day: BENCH_MODE=manual, no BENCH_HOST.
BENCH_HOST=isubench
APP_PRIVATE_IP=172.31.0.10
BENCH_PRIVATE_IP=172.31.0.20

# Fixed evaluation rule (plugin-rule-v2) and budgets. Change per target, never
# per experiment.
MIN_IMPROVEMENT_BP=300     # promote needs median +3% and noise separation
MAX_BENCH_PER_EXP=6
MAX_EXP_MINUTES=30
MAX_EXP_PER_HOUR=6
EVALUATION_RULE=v2         # v2: two samples per side, error rates by denominator. v3 (sequential, one clear sample) is opt-in until compared on real runs
MIN_SAMPLES=2
BASELINE_MAX_AGE_MINUTES=60
MAX_BENCH_TOTAL=120        # includes baseline/recovery/no-result/portal attempts
MAX_BENCH_PER_HOUR=30
RECOVERY_BENCH_RESERVE=1   # leave this many experiment slots for final stable
CORRECTNESS_ERROR_TYPES="" # comma-separated benchmark-specific fatal error types

# Before any SQL/config/resource candidate, fill both commands and prove recovery.
# RESOURCE_HOSTS="$DB_HOST"
# RESOURCE_PATHS="sql etc migrations"
# RESOURCE_FINGERPRINT_CMD='deterministic read-only schema/index/config probe'
# RECOVERY_CMD='approved stable-resource restoration command'
# BENCH_PRECHECK_CMD='refuse while app hosts are busy with package updates'
# BENCH_HOST_PRECHECK_CMD='refuse while the benchmark host is busy'
