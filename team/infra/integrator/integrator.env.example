# /srv/isucon/state/integrator.env (mode 0600, owner isucon). Read by kaizen-integrator.service.
# Claude Code on Amazon Bedrock with the instance role: no API key, no login, no file with a secret.
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=ap-northeast-1
# Cross-region inference profile IDs. The prefix follows the region (ap-* -> apac.); confirm the exact IDs with
#   aws bedrock list-inference-profiles --region ap-northeast-1 --query 'inferenceProfileSummaries[].inferenceProfileId'
# Only the Opus 5.5 ID below appears in the Claude Code documentation; the others are the same pattern, unverified.
ANTHROPIC_MODEL=apac.anthropic.claude-opus-5-5
ANTHROPIC_DEFAULT_OPUS_MODEL=apac.anthropic.claude-opus-5-5
ANTHROPIC_DEFAULT_SONNET_MODEL=apac.anthropic.claude-sonnet-5-5
ANTHROPIC_DEFAULT_HAIKU_MODEL=apac.anthropic.claude-haiku-5-5
# Pin the release on the control host; update at an idle boundary with `claude install <version>` by hand.
DISABLE_UPDATES=1
DISABLE_AUTOUPDATER=1
