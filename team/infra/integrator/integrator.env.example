# /srv/isucon/state/integrator.env (mode 0600, owner isucon). Read by kaizen-integrator.service.
# Claude Code on Amazon Bedrock with the instance role: no API key, no login, no file with a secret.
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=ap-northeast-1
# Inference profile IDs as listed in ap-northeast-1 on 2026-10-18 (`aws bedrock list-inference-profiles`):
# the Tokyo region has `jp.` (Japan-only) and `global.` profiles for the 5.5 models; no `apac.` 5.5 profile exists,
# and Claude Code's built-in defaults would resolve to `apac.` there, so pin every alias and set the prefix.
# Claude 5.5 models answered "not available for this account" until Bedrock's model-access request was granted;
# `jp.anthropic.claude-sonnet-4-6` worked immediately after submitting the use-case form.
ANTHROPIC_BEDROCK_REGION_PREFIX=jp
ANTHROPIC_MODEL=jp.anthropic.claude-opus-5-5
ANTHROPIC_DEFAULT_OPUS_MODEL=jp.anthropic.claude-opus-5-5
ANTHROPIC_DEFAULT_SONNET_MODEL=global.anthropic.claude-sonnet-5-5
ANTHROPIC_DEFAULT_HAIKU_MODEL=jp.anthropic.claude-haiku-5-5
# Pin the release on the control host; update at an idle boundary with `claude install <version>` by hand.
DISABLE_UPDATES=1
DISABLE_AUTOUPDATER=1
