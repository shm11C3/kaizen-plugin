    "schemaVersion": "v1",
    "hypothesisId": "hyp-isucon14-secondary-indexes",
    "hypothesis": "Every table except users and owners has only its primary key, so the per-request lookups by chair_id, user_id, ride_id, owner_id, and access_token scan whole tables; adding secondary indexes on those columns removes the scans and lets the app answer more requests in the 60s load.",
    "observations": [
      {
        "summary": "performance_schema digest after one benchmark: rides WHERE chair_id IS NULL examined 1,129,215 rows for 1,468 calls (49 rows sent); SHOW INDEX lists only PRIMARY on chairs, chair_locations, rides, ride_statuses; middlewares and handlers filter on chair_id, user_id, ride_id, owner_id, access_token",
        "artifact": "observations/2026-10-17-mysql-digest-and-indexes.txt"
      }
    ],
    "allowedChanges": [
      {
        "path": "sql/1-schema.sql",
        "changeKind": "modify",
        "reason": "declare secondary indexes in the schema that POST /api/initialize reloads"
      }
    ],
    "changeSummary": "add six secondary indexes in sql/1-schema.sql: chairs(owner_id), chairs(access_token), chair_locations(chair_id, created_at), rides(chair_id, updated_at), rides(user_id, created_at), ride_statuses(ride_id, created_at)",
    "expectedEffect": "benchmark score rises because handler and matcher queries stop examining whole tables; initialize gets slightly slower from index builds",
